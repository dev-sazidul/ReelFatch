# Copy to backend/.env and fill in only values you are allowed to use.
# Never commit backend/.env. The API reads this file at startup; variables already
# set in your shell take precedence.

PORT=3000
# 127.0.0.1 keeps the API internal: only the Next.js server on this machine reaches it.
# Use 0.0.0.0 only if another host must call the API directly.
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Official Graph API version. See https://developers.facebook.com/docs/graph-api/reference/video/
FACEBOOK_GRAPH_API_VERSION=v26.0

# A User or Page access token from a Meta app the video owner has authorized.
# Empty tokens prevent Graph calls. Public HEAD redirect checks may still run.
# A resolved video id then returns PROVIDER_NOT_CONFIGURED.
# The Page token is used when both are set. Do not paste cookies or session secrets here.
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

REQUEST_TIMEOUT_MS=12000
DOWNLOAD_TIMEOUT_MS=120000
MAX_DOWNLOAD_BYTES=536870912
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60
LOOKUP_TTL_MS=600000
