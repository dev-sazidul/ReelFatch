# Leave empty so the browser calls this same origin and Next.js forwards /api/videos and /api/health.
NEXT_PUBLIC_API_BASE_URL=

# Where Next.js forwards /api/videos and /api/health. Read by the Next.js server only, never the browser.
API_PROXY_TARGET=http://127.0.0.1:3000

# Public HTTPS origin used for canonical URLs, sitemap.xml, and robots.txt. Set this before publishing.
NEXT_PUBLIC_SITE_URL=
